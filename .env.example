APP_NAME=Verdleaf
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
VERDLEAF_PREVIEW=true
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=verdleaf
DB_USERNAME=verdleaf
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

VERDLEAF_SALES_EMAIL=

VERDLEAF_PREVIEW_USER=staging
VERDLEAF_PREVIEW_KEY=
VERDLEAF_GOOGLE_VERIFICATION=

# MFA is mandatory in production; enable for local security testing too.
VERDLEAF_STAFF_MFA=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME=15
